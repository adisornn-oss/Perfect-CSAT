# Required
SESSION_SECRET=            # long random string (signs login sessions)
APP_URL=                   # e.g. https://perfectcsat.thunder.in.th  (used in survey links)
KV_REST_API_URL=           # Upstash Redis REST URL  (or UPSTASH_REDIS_REST_URL)
KV_REST_API_TOKEN=         # Upstash Redis REST token (or UPSTASH_REDIS_REST_TOKEN)
KV_PREFIX=pcsat:           # key namespace inside the shared Redis
ADMIN_EMAIL=               # first admin, created on first start when no users exist
ADMIN_PASSWORD=
ADMIN_NICKNAME=

# Optional — Google Workspace SSO
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_HD=thunder.in.th

# Optional — low-score alerts
LINE_CHANNEL_ACCESS_TOKEN=
LINE_TO=                   # LINE group id
RESEND_API_KEY=
MAIL_FROM=
ALERT_WEBHOOK_URL=         # Google Chat / Slack / Discord incoming webhook
CRON_SECRET=               # protects /api/cron/run (call daily for reminders)
